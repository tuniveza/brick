  1,059 - 1,071   end      the end: put colours back, exit
  1,071 - 1,162   routine  toolbox routine alloc: rcx = bytes wanted -> rax = where they are.
  1,162 - 1,184   routine  toolbox routine new_text: rcx = length -> rax = a new, empty text of that length.
  1,184 - 1,211   routine  toolbox routine write_text: rax = text -> shown on screen.
  1,211 - 1,282   routine  toolbox routine join: rax = first text, rcx = second text -> rax = both, one after the other.
  1,282 - 1,448   routine  toolbox routine number_to_text: rax = whole number -> rax = it written as a text.
  1,448 - 1,904   routine  toolbox routine decimal_to_text: rax = decimal, rcx = places after the point (-1: none if it's whole, else 2) -> rax = text.
  1,904 - 2,097   routine  toolbox routine text_to_number: rax = text -> rax = the whole number at its start (0 if none).
  2,097 - 2,229   routine  toolbox routine same_letters: rsi, rdi = where two runs of letters start, rcx = how many -> rax = 1 if they match.
  2,229 - 2,280   routine  toolbox routine text_equal: rax, rcx = texts -> rax = 1 if they're the same (capitals don't matter), else 0.
  2,280 - 2,349   routine  toolbox routine match_at: rax = text, rcx = smaller text, rdx = position -> rax = 1 if the smaller one is there.
  2,349 - 2,738   routine  toolbox routine contains: rax = text, rcx = smaller text -> rax = 1 if it appears anywhere.
  2,738 - 2,810   routine  toolbox routine letter: rax = text, rcx = N -> rax = its Nth letter (counting from 1), or empty if there isn't one.
  2,810 - 3,014   routine  toolbox routine split: rax = text, rcx = list, rdx = the letter to split at, r8 = 1 to turn pieces into numbers.
  3,014 - 3,149   routine  toolbox routine split_piece
  3,149 - 3,283   routine  toolbox routine letters: rax = text, rcx = list -> the list is emptied, then gets each letter as an item.
  3,283 - 3,468   routine  toolbox routine reverse_text: rax = text -> rax = a new text with its letters the other way round.
  3,468 - 3,557   routine  toolbox routine reverse_list: rax = list, rcx = space for a list -> rax = that space, holding the items the other way round.
  3,557 - 3,788   routine  toolbox routine read_line: -> rax = the text typed before Enter (up to TEXT_LIMIT letters, spaces at the end dropped).
  3,788 - 3,926   routine  toolbox routine read_number: -> rax = a whole number typed by the user. Asks again until it gets one.
  3,926 - 4,212   routine  toolbox routine wait_key: -> rax = the one key pressed (no Enter needed when it's a real terminal).
  4,212 - 4,271   routine  toolbox routine sleep: rax = nanoseconds to wait.
  4,271 - 4,355   routine  toolbox routine random: rax = lowest, rcx = highest -> rax = a random whole number from lowest to highest.
  4,355 - 4,409   routine  toolbox routine now: rdi = which clock (0 time of day, 1 stopwatch) -> rax = nanoseconds.
  4,409 - 4,461   routine  toolbox routine elapsed: rax = a stopwatch start -> rax = seconds since then, as a decimal.
  4,461 - 4,700   routine  toolbox routine time_text: -> rax = the time of day as HH:MM:SS (UTC).
  4,700 - 4,768   routine  toolbox routine push: rax = list, rcx = item -> item added on the end.
  4,768 - 4,858   routine  toolbox routine push_front: rax = list, rcx = item -> item added at the front.
  4,858 - 4,926   routine  toolbox routine remove_first: rax = list, rcx = what to give back if it's empty -> rax = the first item, now removed.
  4,926 - 4,971   routine  toolbox routine remove_last: rax = list, rcx = what to give back if it's empty -> rax = the last item, now removed.
  4,971 - 5,019   routine  toolbox routine item: rax = list, rcx = N, rdx = what to give back if there's no item N -> rax = item N.
  5,019 - 5,202   routine  toolbox routine list_has: rax = list, rcx = thing, rdx = 1 if the items are texts -> rax = 1 if the thing is in the list.
  5,202 - 5,486   routine  toolbox routine list_to_text: rax = list, rcx = kind (0 whole numbers, 1 decimals, 2 texts), rdx = text to put between
  5,486 - 5,500   routine  toolbox routine list_copy: rax = from list, rcx = to list -> the to list becomes the same as the from list.
  5,500 - 5,629   routine  toolbox routine file_save: rax = file name, rcx = text, rdx = how to open (replace or add to the end) -> 1 if it worked.
  5,629 - 5,817   routine  toolbox routine file_load: rax = file name -> rax = everything in it as a text (last line ending dropped), or 0 if there's no such file.
  5,817 - 6,007   routine  toolbox routine file_delete: rax = file name -> asks "are you sure?" first, then deletes it.
  6,007 - 6,099   routine  toolbox routine console_size: -> rax = rows, rcx = columns (24 x 80 if this isn't a console).
  6,099 - 6,263   routine  toolbox routine place_cursor: rax = row (0: stay on this row), rcx = column -> the cursor goes there.
  6,263 - 6,410   routine  toolbox routine getenv: rax = a name followed by '=' (as a text) -> rax = its value as a text, or 0 if it isn't set.
  6,410 - 6,854   routine  toolbox routine desktop: rax = Lua for Hyprland, which can use P (this program's window) -> run it, then wait a moment
